# ─────────────────────────────────────────────────────────────────────────────
# AuraSend — Production Environment Variables Template
# Copy this file to .env.local (dev) or set as server environment variables
# NEVER commit .env.local or actual secrets to git
# ─────────────────────────────────────────────────────────────────────────────

# ─── Core Security ────────────────────────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# ─── App URL ──────────────────────────────────────────────────────────────────
# Used for OAuth callbacks, tracking pixel URLs, unsubscribe links
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Google OAuth (Gmail Integration) ────────────────────────────────────────
# Create at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── AI Features (OpenAI / Gemini) ───────────────────────────────────────────
# OpenAI — optional, for AI email generation
OPENAI_API_KEY=sk-...

# Google Gemini — free tier available
GEMINI_API_KEY=AIza...

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite path — relative to project root
# DB_PATH=./cold-email.db   (default, usually no need to set)

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=production

# ─── Email (Fallback SMTP — for system notifications) ────────────────────────
# Only needed if you want system alert emails sent via SMTP directly
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute per IP for auth endpoints (default: 10)
# AUTH_RATE_LIMIT=10

# ─── Feature Flags ────────────────────────────────────────────────────────────
# ENABLE_AI_FEATURES=true
# ENABLE_EMAIL_WARMUP=true
