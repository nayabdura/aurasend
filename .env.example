# ==============================================================================
# AuraSend (ColdMail.os) — Production Environment Variables Template
# Copy this file to .env or .env.local for local development.
# Configure these variables in Vercel Project Settings for Production.
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & ORM (Server-Only)
# ------------------------------------------------------------------------------
# Managed PostgreSQL Connection Pool URL (Prisma Postgres / Neon / Supabase PgBouncer)
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15"

# Direct Database URL for Prisma Migrations (Bypasses Connection Pooler)
DIRECT_URL="postgresql://user:password@ep-direct.region.aws.neon.tech/neondb"

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (Server-Only)
# ------------------------------------------------------------------------------
# Secret key used for signing JWT session cookies (Minimum 32 random characters)
JWT_SECRET="your_production_jwt_super_secret_key_min_32_chars"

# Master Admin Email (Automated initial admin bootstrap)
MASTER_ADMIN_EMAIL="admin@yourdomain.com"
MASTER_ADMIN_PASSWORD="your_secure_admin_password"

# ------------------------------------------------------------------------------
# 3. PUBLIC APP CONFIGURATION (Client-Facing & Build-Time)
# ------------------------------------------------------------------------------
# Production base URL of your application (Used for OAuth callbacks & links)
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH & GMAIL API (Server-Only)
# ------------------------------------------------------------------------------
# Google Cloud Console Credentials (OAuth 2.0 Web Application)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/auth/google/callback"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI API (Server-Only)
# ------------------------------------------------------------------------------
# Gemini API Key for lead personalization engine (Google AI Studio)
GEMINI_API_KEY="your_gemini_api_key"

# ------------------------------------------------------------------------------
# 6. STRIPE BILLING & PAYMENTS (Server-Only)
# ------------------------------------------------------------------------------
# Stripe API Keys (Stripe Dashboard)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# Stripe Price IDs for Subscription Plans
STRIPE_STARTER_MONTHLY_PRICE_ID="price_starter_monthly_id"
STRIPE_STARTER_YEARLY_PRICE_ID="price_starter_yearly_id"
STRIPE_PRO_MONTHLY_PRICE_ID="price_pro_monthly_id"
STRIPE_PRO_YEARLY_PRICE_ID="price_pro_yearly_id"
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_business_monthly_id"
STRIPE_BUSINESS_YEARLY_PRICE_ID="price_business_yearly_id"

# ------------------------------------------------------------------------------
# 7. VERCEL CRON & SYSTEM (Server-Only)
# ------------------------------------------------------------------------------
# Cron Authorization Bearer Secret for securing /api/cron/* endpoints
CRON_SECRET="your_random_cron_secret_bearer_token"
