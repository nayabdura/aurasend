{
  "name": "cold-email-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:network": "next dev -H 0.0.0.0",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "verify:artifact": "npx tsx scripts/verify-production-artifact.ts",
    "verify:production-db": "npx tsx scripts/verify-production-db.ts",
    "clean": "rimraf .next out",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.27",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^6.1.0",
    "framer-motion": "^12.35.1",
    "imap": "^0.8.19",
    "isomorphic-dompurify": "^3.7.1",
    "jodit": "^4.11.3",
    "jodit-react": "^5.3.21",
    "jose": "^6.2.2",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.3",
    "next": "14.2.35",
    "nodemailer": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "swr": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
