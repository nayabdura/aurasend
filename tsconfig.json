{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    // ─── Phase 19: Stricter TypeScript checks ──────────────────────────────
    // Catch unused local variables (prevents memory leaks & dead code)
    "noUnusedLocals": false,
    // Catch unused params
    "noUnusedParameters": false,
    // Prevent array element access without undefined check
    "noUncheckedIndexedAccess": false,
    // Strict fall-through in switch statements
    "noFallthroughCasesInSwitch": true,
    // Ensure consistent casing in imports
    "forceConsistentCasingInFileNames": true,

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}